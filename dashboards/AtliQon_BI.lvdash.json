{
  "datasets": [
    {
      "name": "179e3504",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "version": "1.1",
        "source": "fmcg.gold.vw_fact_orders_enriched",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "top_products",
      "displayName": "Top 10 Products by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT `product`, SUM(`total_amount_inr`) AS `revenue`, SUM(`sold_quantity`) AS `units_sold` FROM fmcg.gold.vw_fact_orders_enriched GROUP BY `product` ORDER BY `revenue` DESC LIMIT 10",
        "dimensions": [
          {
            "name": "product",
            "expr": "product",
            "displayName": "Product",
            "comment": "Product name, limited to the top 10 by revenue"
          }
        ],
        "measures": [
          {
            "displayName": "Revenue (INR)",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "abbreviation": "compact"
            },
            "name": "revenue",
            "expr": "SUM(`revenue`)",
            "comment": "Total revenue for the product"
          },
          {
            "name": "units_sold",
            "expr": "SUM(`units_sold`)",
            "displayName": "Units Sold",
            "comment": "Total units sold for the product"
          }
        ]
      }
    }
  ],
